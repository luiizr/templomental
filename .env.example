# PostgreSQL local
POSTGRES_DB="templomental"
POSTGRES_USER="templomental"
POSTGRES_PASSWORD="substitua-por-uma-senha-local"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://templomental:substitua-por-uma-senha-local@localhost:5432/templomental"

# Gere e use um valor longo e aleatório para desenvolvimento e produção.
SEGREDO_DA_SESSAO="substitua-por-um-segredo-longo-e-aleatorio"
